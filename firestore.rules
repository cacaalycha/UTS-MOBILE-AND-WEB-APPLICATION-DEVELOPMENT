// Praktikum Minggu 11 — Cloud Firestore (Case iPhone Caca)
//
// Salin seluruh isi file ini ke Firebase Console:
//   Build > Firestore Database > tab Rules > Publish
//
// Perubahan dari Minggu 10: tulisan tidak lagi "semua yang login boleh semua".
// Sekarang berlaku aturan KEPEMILIKAN:
//   - users/{uid}     hanya bisa dibaca/ditulis oleh pemilik uid tersebut.
//   - cases/{id_case} master data: semua yang login boleh baca & tulis.
//   - orders/{id}     buat hanya dengan id_pengguna == uid dan status Menunggu;
//                     ubah/hapus hanya oleh pemilik DAN status masih Menunggu.
//
// Aturan bisnis yang sama juga ditulis di kode (lib/data/data_simulasi.dart)
// supaya pesan galat di UI jelas. Rules ini adalah lapisan pengaman terakhir
// bila API dipanggil langsung dari luar aplikasi.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function sudahMasuk() {
      return request.auth != null;
    }

    function pemilik(data) {
      return sudahMasuk() && data.id_pengguna == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if sudahMasuk() && request.auth.uid == uid;
    }

    match /cases/{idCase} {
      allow read: if sudahMasuk();
      allow write: if sudahMasuk();
    }

    match /orders/{idPesanan} {
      allow create: if pemilik(request.resource.data)
                    && request.resource.data.status == 'Menunggu';
      allow read: if sudahMasuk();
      allow update, delete: if pemilik(resource.data)
                            && resource.data.status == 'Menunggu';
    }
  }
}
